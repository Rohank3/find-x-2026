# ==============================================================================
# FIND X — Cryptic Hunt Platform Environment Variables
# ==============================================================================

# Node Environment ("development" | "production")
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# Database: PostgreSQL
# Local dev:      postgresql://findx:findxpassword@localhost:5432/findx_db?schema=public
# Docker network: postgresql://findx:findxpassword@postgres:5432/findx_db?schema=public
# Managed cloud:  postgresql://<user>:<password>@<neon-or-supabase-host>/findx_db?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://findx:findxpassword@localhost:5432/findx_db?schema=public"

# ------------------------------------------------------------------------------
# Redis Cache & Lockout State Machine
# Local dev:      redis://localhost:6379
# Docker network: redis://redis:6379
# Upstash / TLS:  rediss://default:<password>@<endpoint>.upstash.io:6379
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# NextAuth Authentication
# NEXTAUTH_URL: Set to your canonical domain in production (e.g. https://findx.ecell.in)
# NEXTAUTH_SECRET: Generate a 32+ char secret using `openssl rand -base64 32`
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="findx_super_secret_session_encryption_key_change_in_prod"

# ------------------------------------------------------------------------------
# Google OAuth Credentials
# In development, a mock auth fallback is active when these are dummy values.
# In production, provide real credentials from Google Cloud Console.
# Authorized Redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# Organizers & Admin Whitelist (comma-separated college / organizer emails)
# Users logging in with these emails are automatically provisioned with the ORGANIZER role.
# ------------------------------------------------------------------------------
ADMIN_EMAILS="admin@iiitl.ac.in,organizer@iiitl.ac.in,ecell@iiitl.ac.in"

# ------------------------------------------------------------------------------
# Multimedia & Cipher Storage Provider ("local" | "supabase" | "r2")
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local"
